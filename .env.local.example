# Supabase 연결 (선택). 값을 넣고 파일명을 .env.local 로 저장 후 dev 재시작.
# 미설정 시 앱은 로컬(localStorage) 추적 폴백으로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 관리자 대시보드(/admin) 로그인. 미설정 시 기본값(admin / volta-admin-2026!).
# NEXT_PUBLIC_ 은 번들에 노출되므로 편의용입니다. 실보안은 Supabase role='admin' 검증 사용.
NEXT_PUBLIC_ADMIN_ID=
NEXT_PUBLIC_ADMIN_PW=
